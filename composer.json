{
	"name": "idmarinas/media-bundle",
	"description": "Media management bundle for Symfony: upload, organize, and attach images and videos to your entities.",
	"type": "symfony-bundle",
	"keywords": ["symfony-bundle", "media-bundle"],
	"homepage": "https://github.com/idmarinas/media-bundle",
	"license": "BSD-3-Clause",
	"authors": [{
			"name": "Iván Diaz Marinas (IDMarinas)",
			"email": "35842929+idmarinas@users.noreply.github.com",
			"role": "Author, Developer, Maintainer"
		}],
	"support": {
		"issues": "https://github.com/idmarinas/media-bundle/issues"
	},
	"funding": [{
			"type": "paypal",
			"url": "https://www.paypal.me/idmarinas"
		}, {
			"type": "github-sponsors",
			"url": "https://github.com/sponsors/idmarinas"
		}],
	"require": {
		"php": "^8.3",
		"symfony/config": "^6.4 | ^7.1 | ^8.0",
		"symfony/dependency-injection": "^6.4 | ^7.1 | ^8.0",
		"symfony/framework-bundle": "^6.4 | ^7.1 | ^8.0"
	},
	"require-dev": {
		"dama/doctrine-test-bundle": "^8.2",
		"doctrine/doctrine-fixtures-bundle": "^3.0 | ^4.0",
		"idmarinas/composer-plugin": "^1.0",
		"php-mock/php-mock-phpunit": "^2.12",
		"phpunit/phpunit": "^12.5",
		"rector/rector": "^2.0",
		"symfony/browser-kit": "^6.4 | ^7.1 | ^8.0",
		"symfony/console": "^6.4 | ^7.1 | ^8.0",
		"symfony/css-selector": "^6.4 | ^7.1 | ^8.0",
		"symfony/maker-bundle": "^1.61",
		"symfony/runtime": "^6.4 | ^7.1 | ^8.0",
		"symfony/twig-bundle": "^6.4 | ^7.1 | ^8.0",
		"zenstruck/foundry": "^2.3"
	},
	"autoload": {
		"psr-4": {
			"Idm\\Bundle\\MediaBundle\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\": "tests/app/src/",
			"Idm\\Bundle\\MediaBundle\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"scripts": {
		"fixtures:load": [
			"php bin/console doctrine:schema:drop --force --ansi",
			"php bin/console doctrine:schema:update --force --ansi",
			"php bin/console doctrine:fixtures:load -n --ansi"
		],
		"dev:fixtures:load": "@composer fixtures:load -- --env=dev",
		"test:fixtures:load": "@composer fixtures:load -- --env=test"
	},
	"config": {
		"allow-plugins": {
			"composer/package-versions-deprecated": true,
			"idmarinas/composer-plugin": true,
			"symfony/flex": true,
			"symfony/runtime": true
		},
		"optimize-autoloader": false,
		"preferred-install": {
			"*": "dist"
		},
		"sort-packages": true
	},
	"extra": {
		"thanks": {
			"name": "idmarinas/media-bundle",
			"url": "https://github.com/idmarinas/media-bundle"
		}
	}
}
